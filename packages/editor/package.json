{
  "name": "@duckeditor/core",
  "version": "0.1.0-beta.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "INTEROP.md",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "prepack": "bun run build:lib",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.7.9",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^1.1.0",
    "@floating-ui/react": "^0.27.19",
    "@duckeditor/spec": "workspace:*",
    "@xstate/react": "^6.1.0",
    "bippy": "^0.5.32",
    "fast-deep-equal": "^3.1.3",
    "neverthrow": "^8.0.0",
    "react-shadow": "^20.6.0",
    "tinykeys": "^3.0.0",
    "xstate": "^5.29.0"
  },
  "peerDependencies": {
    "@duckeditor/patterns": "workspace:*",
    "@puckeditor/core": "^0.21.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@duckeditor/patterns": {
      "optional": true
    }
  },
  "devDependencies": {
    "@duckeditor/patterns": "workspace:*",
    "@happy-dom/global-registrator": "^20.8.9",
    "@playwright/test": "^1.58.2",
    "@types/bun": "^1.3.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
